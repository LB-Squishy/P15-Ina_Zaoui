{% extends 'front.html.twig' %}

{% block title %}Ina Zaoui - {{ guest.name }}{% endblock %}

{% block front %}
    <div class="row">
        <div class="col-12">
            <h3 class="mb-4">{{ guest.name }}</h3>
            <p class="mb-5 w-100">{{ guest.description }}</p>
            <div class="row">
                {% for media in medias %}
                    <div class="col-4 media mb-4">
                        <img class="w-100" src="{{ asset(media.path) }}" alt="{{ media.title }}">
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% set totalPages = (total / 9)|round(0, 'ceil') %}

    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            {% if page > 1 %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('guest', {id: guest.id, page: 1}) }}">&laquo;</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="{{ path('guest', {id: guest.id, page: page - 1}) }}">Précédent</a>
                </li>
            {% endif %}

            {% for i in range(max(1, page - 2), min(totalPages, page + 2)) %}
                <li class="page-item {% if i == page %}active{% endif %}">
                    <a class="page-link" href="{{ path('guest', {id: guest.id, page: i}) }}">{{ i }}</a>
                </li>
            {% endfor %}

            {% if page < totalPages %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('guest', {id: guest.id, page: page + 1}) }}">Suivant</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="{{ path('guest', {id: guest.id, page: totalPages}) }}">&raquo;</a>
                </li>
            {% endif %}
        </ul>
    </nav>
{% endblock %}

