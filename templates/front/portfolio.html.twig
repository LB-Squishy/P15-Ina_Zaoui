{% extends 'front.html.twig' %}

{% block title %}Ina Zaoui - Portfolio{% endblock %}

{% block front %}
    <div class="row">
        <div class="col-12">
            <h3 class="mb-4">Portfolio</h3>
            <div class="mb-5 row">
                <div class="col-2">
                    <a class="btn w-100 py-3 {{ album is null ? 'active' }}" href="{{ path('portfolio') }}">
                        Toutes
                    </a>
                </div>
                {% for a in albums %}
                    <div class="col-2 mb-4">
                        <a class="btn w-100 py-3 {{ album == a ? 'active' }}" href="{{ path('portfolio', {id: a.id}) }}">
                            {{ a.name }}
                        </a>
                    </div>
                {% endfor %}
            </div>
            <div class="row">
                {% for media in medias %}
                    <div class="col-4 media mb-4">
                        <img class="w-100" src="{{ asset(media.path) }}" alt="{{ media.title }}">
                        <p class="text-center mb-0 mt-2 media-title">{{ media.title }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% set totalPages = (total / 6)|round(0, 'ceil') %}

    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            {% if page > 1 %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('portfolio', {id: album ? album.id : null, page: 1}) }}">&laquo;</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="{{ path('portfolio', {id: album ? album.id : null, page: page - 1}) }}">Précédent</a>
                </li>
            {% endif %}

            {% for i in range(max(1, page - 2), min(totalPages, page + 2)) %}
                <li class="page-item {% if i == page %}active{% endif %}">
                    <a class="page-link" href="{{ path('portfolio', {id: album ? album.id : null, page: i}) }}">{{ i }}</a>
                </li>
            {% endfor %}

            {% if page < totalPages %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('portfolio', {id: album ? album.id : null, page: page + 1}) }}">Suivant</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="{{ path('portfolio', {id: album ? album.id : null, page: totalPages}) }}">&raquo;</a>
                </li>
            {% endif %}
        </ul>
    </nav>
{% endblock %}

