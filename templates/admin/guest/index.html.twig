{% extends 'admin.html.twig' %}

{% block title %}{{ app.user.name }} - Invités{% endblock %}

{% block admin %}
    <div class="d-flex justify-content-between align-items-center">
        <h1>Invités</h1>
        <a href="{{ path('admin_guest_add') }}" class="btn btn-primary">Ajouter</a>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Email</th>
                <th>Accès Admin</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for guest in guests %}
                <tr>
                    <td>{{ guest.name }}</td>
                    <td>{{ guest.email }}</td>
                    <td class="d-flex align-items-center gap-3">
                        {% if guest.admin %}
                            <i class="bi bi-check-lg text-success"></i>
                            <a href="{{ path('admin_guest_update', {id: guest.id}) }}" class="btn btn-warning" style="width: 100px;">
                                Bloquer
                            </a>
                        {% else %}
                            <i class="bi bi-x-lg text-danger"></i>
                            <a href="{{ path('admin_guest_update', {id: guest.id}) }}" class="btn btn-success" style="width: 100px;">
                                Autoriser
                            </a>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('admin_guest_delete', {id: guest.id}) }}" class="btn btn-danger">Supprimer</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    {% set totalPages = (total / 25)|round(0, 'ceil') %}

    <nav aria-label="Page navigation">
        <ul class="pagination">
            {% if page > 1 %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('admin_guest_index', {page: 1}) }}">Première page</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="{{ path('admin_guest_index', {page: page - 1}) }}">Précédent</a>
                </li>
            {% endif %}

            {% for i in range(max(1, page - 3), min(totalPages, page + 3)) %}
                <li class="page-item {% if i == page %}active{% endif %}">
                    <a class="page-link" href="{{ path('admin_guest_index', {page: i}) }}">{{ i }}</a>
                </li>
            {% endfor %}

            {% if page < totalPages %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('admin_guest_index', {page: page + 1}) }}">Suivant</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="{{ path('admin_guest_index', {page: totalPages}) }}">Dernière page</a>
                </li>
            {% endif %}
        </ul>
    </nav>
{% endblock %}