{% extends 'base.html.twig' %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-3 col-lg-2 d-none d-md-block bg-dark sidebar position-fixed top-0 bottom-0 overflow-auto p-4">
                <div class="position-sticky">
                    <h1 class="text-white">Admin</h1>
                    <p class="text-white-50 small">{{ app.user.name }}</p>
                    <hr class="text-white-50" />
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('admin_media_index') }}">
                                Medias
                            </a>
                        </li>
                        {% if is_granted('ROLE_SUPER_ADMIN') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('admin_album_index') }}">
                                    Albums
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('admin_guest_index') }}">
                                    Invités
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                    <div class="mt-4">
                        <a href="{{ path('home') }}" class="btn btn-outline-light btn-sm w-100">Retour au site</a>
                    </div>
                    <div class="mt-4">
                        <a href="{{ path('admin_logout') }}" class="btn btn-outline-danger btn-sm w-100">Déconnexion</a>
                    </div>
                </div>
            </nav>
            <main class="col-md-9 ms-sm-auto col-lg-10 p-4">
                {% block admin %}{% endblock %}
            </main>
        </div>
    </div>
{% endblock %}