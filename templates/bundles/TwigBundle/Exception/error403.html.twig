{% extends 'base.html.twig' %}

{% block title %}Ina Zaoui - Page Not Found{% endblock %}

{# 
Ne s'affiche qu'en production, lorsque une page 404 est rencontrée. 
Pour l'afficher 
- allez sur l'url http://127.0.0.1:8081/_error/403 en dev,
ou
- passez en prod avec APP_ENV=prod apres compilation des assets. 
#}

{% block body %}
<div class="container d-flex flex-column align-items-center justify-content-center" style="height: 100vh;">
    <div class="text-center">
        <h1 class="display-1 fw-light mb-4">404</h1>
        <p class="h3 text-dark mb-3">Not Found</p>
        <p class="mb-4">La page que vous recherchez n'existe pas ou a été déplacée.</p>
        <a href="{{ path('home') }}" class="btn btn-dark btn-lg">Retour à l'accueil</a>
    </div>
</div>
{% endblock %}
